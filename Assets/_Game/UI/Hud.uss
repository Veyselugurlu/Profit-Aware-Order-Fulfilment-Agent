/* HUD theme: dark panels over the map, one accent colour, state colours shared with Palette.cs */

.hud-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(236, 239, 241);
    font-size: 14px;
}

.panel {
    background-color: rgba(22, 27, 36, 0.92);
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
}

/* ---------------------------------------------------------------- top bar */

.top-bar {
    position: absolute;
    left: 0; top: 0; right: 0;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    border-top-width: 0; border-left-width: 0; border-right-width: 0;
}

.title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(79, 195, 247);
    margin-right: 18px;
}

.tool-button {
    height: 34px;
    min-width: 64px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(43, 50, 64);
    border-width: 0;
    border-radius: 6px;
    color: rgb(236, 239, 241);
    font-size: 14px;
}

.tool-button:hover { background-color: rgb(58, 67, 85); }
.tool-button:active { background-color: rgb(30, 36, 46); }

.tool-button.primary {
    background-color: rgb(2, 119, 189);
    -unity-font-style: bold;
    min-width: 116px;
}
.tool-button.primary:hover { background-color: rgb(3, 136, 209); }

.speed-group {
    flex-direction: row;
    margin-left: 14px;
    padding: 2px;
    background-color: rgb(30, 36, 46);
    border-radius: 8px;
}
.speed-group .tool-button { min-width: 44px; margin-left: 1px; margin-right: 1px; }
.speed-group .tool-button.selected { background-color: rgb(79, 195, 247); color: rgb(16, 20, 27); -unity-font-style: bold; }

.clock {
    margin-left: 22px;
    width: 150px;
}
.clock-time {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}
.progress {
    height: 5px;
    margin-top: 3px;
    background-color: rgb(43, 50, 64);
    border-radius: 3px;
}
.progress-fill {
    height: 5px;
    width: 0;
    background-color: rgb(79, 195, 247);
    border-radius: 3px;
}

.episode-info {
    flex-grow: 1;
    align-items: flex-end;
}
.episode-info Label { -unity-text-align: middle-right; color: rgb(176, 190, 197); }
.status { color: rgb(255, 213, 79); font-size: 13px; }

/* ---------------------------------------------------------------- KPI strip */

.kpi-strip {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 70px;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
}

.kpi {
    align-items: center;
    min-width: 120px;
}
.kpi-value {
    font-size: 22px;
    -unity-font-style: bold;
}
.kpi-value.bad { color: rgb(255, 167, 38); }
.kpi-caption {
    font-size: 12px;
    color: rgb(144, 164, 174);
}

/* ---------------------------------------------------------------- inspection panel */

/* Right sidebar: fixed column between the top bar and the KPI strip (CameraController keeps the map out of it). */
.info-panel {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 70px;
    width: 340px;
    padding: 14px 16px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
}
.info-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(79, 195, 247);
    margin-bottom: 6px;
    white-space: normal;
}
.info-body {
    white-space: normal;
    font-size: 14px;
}
.info-panel.empty .info-title { color: rgb(144, 164, 174); }
.hint {
    margin-top: 8px;
    font-size: 11px;
    color: rgb(120, 137, 147);
    white-space: normal;
}

/* ---------------------------------------------------------------- map labels */

.label-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.map-label {
    position: absolute;
    translate: -50% -50%;
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background-color: rgba(16, 20, 27, 0.7);
    color: rgb(207, 216, 220);
}
.label-center {
    -unity-font-style: bold;
    color: rgb(79, 195, 247);
    font-size: 13px;
}
.label-region { color: rgb(209, 196, 233); }
